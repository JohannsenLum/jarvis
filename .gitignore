# Secrets
.env

# Your personal second brain stays out of the repo (it's public). Only the schema and page
# templates are shared; setup creates index.md, log.md and now.md locally.
# Put knowledge/ in its own PRIVATE git repo if you want history (recommended).
knowledge/*
!knowledge/SCHEMA.md
!knowledge/_templates/
!knowledge/inbox/
!knowledge/raw/
knowledge/inbox/*
knowledge/raw/*
!knowledge/inbox/.gitkeep
!knowledge/raw/.gitkeep

# Skills Jarvis teaches itself are personal too
skills/learned/*
!skills/learned/.gitkeep

.DS_Store
.obsidian/workspace*.json
__pycache__/
