{
  "name": "create-jarvis",
  "version": "1.0.0",
  "description": "Make your own Jarvis: a personal assistant brain (identity, vault, skills, sub-agents, MCP tools) that works in Claude Code, Codex, Grok Build, Gemini, Hermes and more.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "create-jarvis": "bin/create-jarvis.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "files": [
    "bin",
    "core",
    "mcp",
    "hooks",
    "skills",
    "agents",
    "frameworks",
    "adapters",
    "office",
    "framework.json",
    "knowledge/SCHEMA.md",
    "knowledge/_templates",
    "deps.env",
    "README.md",
    ".claude-plugin",
    ".mcp.json",
    "LICENSE",
    "SECURITY.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JohannsenLum/jarvis.git"
  },
  "keywords": [
    "jarvis",
    "assistant",
    "claude-code",
    "codex",
    "agent-skills",
    "mcp",
    "second-brain",
    "obsidian"
  ],
  "scripts": {
    "check": "python3 scripts/check.py",
    "test": "python3 -m unittest discover -s tests -p \"test_*.py\" -v && node --test --test-concurrency=1 tests/*.test.mjs",
    "test:isolated": "bash scripts/test-isolated.sh"
  }
}
