# Repos Jarvis depends on. setup.sh fetches any that are missing.
#
# jarvis-voice: the desk voice client. Installed next to this repo unless JARVIS_VOICE_DIR is set
# (setup.sh saves it here if you point it at a folder you already have).
# Set the URL once the repo is published (e.g. https://github.com/<you>/jarvis-voice.git).
JARVIS_VOICE_REPO=https://github.com/JohannsenLum/jarvis-voice.git
JARVIS_VOICE_REF=main
